# ───────── OS 杂项 ─────────
.DS_Store
Thumbs.db
desktop.ini

# ───────── Rust ─────────
# 编译产物（占空间大、可重新生成）
/target/
# Cargo.lock：binary crate 应提交，但若想精简体积可忽略
# 取消下行注释以忽略（一般 binary crate 推荐提交）
# /Cargo.lock

# ───────── Node / Vite 前端 ─────────
# 依赖与构建缓存（巨大，必须忽略）
/frontend/node_modules/
/frontend/.vite/
/frontend/dist/

# ───────── 前端构建产物 ─────────
# 默认运行模式（start_server.bat）使用 Vite 编译到 /static/
# 该目录由 `npm run build` 重新生成，不提交
/static/

# ───────── 运行时数据（隐私 + 大体积）─────────
# SQLite 数据库（含用户、密码哈希、上传历史）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
# 显式屏蔽项目根 data.db（即使被通配符覆盖，这里再确保一次）
/data.db

# 用户上传文件（占空间巨大、可能含隐私内容）
/uploads/

# JWT 密钥（一旦泄露，签发的 token 全部可被伪造）
.secret_key
*.secret_key
secret.key

# 环境变量
.env
.env.local
.env.*.local

# ───────── 废弃前端 ─────────
# static_admin 管理端独立前端已删除并归档（管理功能并入 Vue /admin），
# 若历史遗留重新出现（如从备份恢复），也不应被提交
/static_admin/

# ───────── 包管理器日志 ─────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────── IDE / 编辑器 ─────────
.vscode/
.idea/
*.swp
*.swo
*~

# ───────── 日志 ─────────
*.log

# ───────── 本地规划文档 / IDE 草稿（个人笔记，不应上库）─────────
# .trae/ 是 Trae IDE 的本地工作目录，含规划文档、个人草稿
# 这些不是项目源代码，避免隐私与冗余
/.trae/

# ───────── 临时文件 ─────────
*.tmp
*.temp
*.bak
*.orig
*.rej

# Windows 可执行残留
*.exe
*.dll
*.pdb
