# ============================================================================
# 部署配置 —— 唯一需要改的地方
# ============================================================================
#
# compose、裸机 systemd、docker run 全部读这一份，不各写一套。
# 换部署方式时不用重新对一遍参数，也就不会出现「容器里改了、裸机忘了」。
#
# 用法：
#   cp deploy.env.example deploy.env && 编辑 deploy.env
#   docker compose --env-file deploy.env up -d
#
# ⚠️ deploy.env 含密钥，不要提交到版本库（已在 .gitignore 里）。
# ⚠️ 改完必须重启：这些值只在进程启动时读取。

# ── 监听地址 ──────────────────────────────────────────────────
# 容器内必须用 0.0.0.0：容器里的 127.0.0.1 指向容器自身，
# 同一个 compose 网络里的 cloudflared 根本连不上。
# 安全性不靠这个地址，而靠**不写 ports:** ——见 compose.yaml 的说明。
# 裸机部署则相反，应改成 127.0.0.1。
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── 路径（容器内）─────────────────────────────────────────────
# 三个数据路径都指向 /data，即下面的 pan-data 卷。
# SQLite 的 data.db / -wal / -shm 必须同卷，拆开存放会丢 WAL。
DATABASE_PATH=/data/data.db
UPLOAD_DIR=/data/uploads
STATIC_DIR=/app/static

# ── JWT 密钥 ─────────────────────────────────────────────────
# 指向卷内文件而非环境变量：密钥不该出现在 `docker inspect` 输出里。
# 首次启动前必须准备好这个文件（见本文件末尾的生成命令），
# 否则 config.rs:47 会直接 panic，容器进入 restart 循环。
# 内容需 ≥32 字节。
JWT_SECRET_KEY_FILE=/data/secret.key

# ── 行为 ─────────────────────────────────────────────────────
# 单文件上限，默认 10GB。
# ⚠️ 若走 Cloudflare Tunnel，这个值可以很大，但**单次请求**仍受
#    Cloudflare 的 100MB 上传上限约束（Enterprise 可调）——
#    那是 CDN 侧的限制，与本项无关。两件事都需要满足，取小的那个。
MAX_FILE_SIZE=10737418240

# 孤儿文件回收扫描间隔（秒）。0 表示关闭，仅测试用。
GC_INTERVAL_SEC=600

# 首次启动时创建的管理员。
# 密码留空则不创建账号（db.rs 里有对应逻辑）。⚠️ 一旦创建就会长期有效，
# 建议首次登录后立刻在管理端改掉，并从本文件里清空密码。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# 空格或逗号分隔。公网部署**必须**配成自己的域名，
# 否则白名单里只剩 localhost，同源部署虽能工作但没有余量。
# 例：https://photos.example.com
CORS_ALLOWED_ORIGINS=

RUST_LOG=info

# ============================================================================
# 首次启动前，在项目根目录执行一次：
#
#   mkdir -p data && openssl rand -base64 48 > data/secret.key
#   chmod 600 data/secret.key
#
# Windows（PowerShell）：
#   New-Item -ItemType Directory -Force data | Out-Null
#   $bytes = New-Object byte[] 48
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [IO.File]::WriteAllBytes("data/secret.key", $bytes)
#
# 备份时 data.db + uploads/ + secret.key 三者必须一起备。
# 丢了 secret.key 会让所有已签发的 JWT 立即失效（用户被强制登出）。
# 备份数据库**不能直接 cp**——WAL 模式下会得到一个 1 页的空壳文件，
# 必须用 sqlite3 data.db ".backup '/backup/data.db'"。详见 DEPLOY_RECHECK.md §3.4。
# ============================================================================

# ── Cloudflare Tunnel ─────────────────────────────────────────
# 隧道 ID。**docker compose 缺少它会直接拒绝启动**（连 app 服务都起不来），
# 所以这项必填，除非你只想在本机跑、不接 Cloudflare。
# 获取：Zero Trust -> Networks -> Tunnels -> Create a tunnel，
# 创建后把返回的隧道 ID 填在下面。
# 快速隧道（trycloudflare.com）不需要本项，但那条路每次换地址、只适合调试。
TUNNEL_ID=

# 令牌方式登录（dashboard 创建的隧道会给这个）。与 TUNNEL_ID 二选一：
# 命名隧道用 TUNNEL_ID + config，dashboard 隧道用 TUNNEL_TOKEN。
TUNNEL_TOKEN=
